{
  "entities": {
    "Listing": {
      "title": "Listing",
      "description": "A classified advertisement posted by a user in the marketplace.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the user who created the listing."
        },
        "sellerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Public display name of the seller."
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120,
          "description": "Headline of the classified advertisement."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "description": "Detailed description of the item or service."
        },
        "category": {
          "type": "string",
          "enum": ["real_estate", "vehicles", "electronics", "furniture", "appliances", "fashion", "services"],
          "description": "Primary category of the listing."
        },
        "city": {
          "type": "string",
          "enum": ["riyadh", "jeddah", "dammam", "makkah", "madinah", "khobar", "abha", "other"],
          "description": "City where the listing is located."
        },
        "district": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional neighborhood or district name."
        },
        "condition": {
          "type": "string",
          "enum": ["new", "like_new", "good", "fair", "not_applicable"],
          "description": "Physical condition of the item."
        },
        "price": {
          "type": "number",
          "description": "Asking price in the selected currency."
        },
        "currency": {
          "type": "string",
          "enum": ["SAR", "AED", "USD"],
          "description": "Currency code."
        },
        "negotiable": {
          "type": "boolean",
          "description": "Whether the asking price is negotiable."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000,
          "description": "Image path, HTTPS URL, or compressed JPEG/WebP data URI."
        },
        "status": {
          "type": "string",
          "enum": ["active", "sold", "paused"],
          "description": "Current visibility and availability status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the listing was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the listing was last updated."
        }
      },
      "required": [
        "ownerId",
        "sellerName",
        "title",
        "description",
        "category",
        "city",
        "condition",
        "price",
        "currency",
        "negotiable",
        "imageUrl",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A user's saved bookmark referencing a listing.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "listingId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "listingId", "createdAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user preferences and contact metadata accessible only by the owner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "defaultCity": {
          "type": "string",
          "enum": ["riyadh", "jeddah", "dammam", "makkah", "madinah", "khobar", "abha", "other"]
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "defaultCity", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct buyer message or offer on a specific listing.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sellerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "buyerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "buyerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "offerPrice": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["open", "replied", "closed"]
        },
        "sellerReply": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "listingId",
        "listingTitle",
        "sellerId",
        "buyerId",
        "buyerName",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Publicly browsable classified listings with owner-restricted mutations."
    },
    "/users/{userId}/favorites/{listingId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User's saved favorite listing references."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private PII and user profile preferences."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Private buyer-to-seller inquiries and price offers."
    }
  }
}
